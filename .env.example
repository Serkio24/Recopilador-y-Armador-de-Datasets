# Copiar a .env y rellenar. Es opcional: sin esta variable la aplicacion
# funciona igual, buscando con yt-dlp y dejando la columna `pais_canal` vacia.
# Obtener la key en https://console.cloud.google.com -> APIs -> YouTube Data API v3
#
# Se usa para dos cosas distintas, con costes de cuota muy distintos:
#   - pais declarado del canal (channels.list): 1 unidad por cada 50 canales.
#     Enriquecer 10.000 videos son ~200 de las 10.000 unidades diarias.
#   - backend de busqueda (search.list): 100 unidades por busqueda, o sea
#     ~100 busquedas al dia. Por eso NO se activa solo por tener la key:
#     hay que pedirlo a proposito con BUSCADOR_VIDEOS (ver abajo).
YOUTUBE_API_KEY=

# Quien descubre los videos: ytdlp (por defecto, sin cuota) | api | auto.
# "auto" usa la API si hay key, que era el comportamiento de versiones previas.
BUSCADOR_VIDEOS=ytdlp
